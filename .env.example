# Copy to .env and fill in values. Never commit real secrets.

# OpenAI (Round 1 n8n HTTP + Round 2 MVP)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: LangSmith (Round 2 only — do not submit a LangSmith project in Round 1)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=capstone-lead-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional n8n / webhook demo
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/lead-score

# ---------------------------------------------------------------------------
# Lead Desk (lead_desk/) — see lead_desk/README.md for what each variable does.
# Every service is optional. The CLI desk is the only delivery channel: nothing is sent
# to customers or agents. WhatsApp is deferred until after real MVP tests.
# ---------------------------------------------------------------------------
LEAD_DESK_DB_PATH=lead_desk.sqlite3
LEAD_DESK_TENANT_ID=tenant_demo
LEAD_DESK_MAX_MATCHES=3

# Telegram intake webhook stub (the secret_token you pass to Telegram setWebhook)
TELEGRAM_WEBHOOK_SECRET=

# Email intake (IMAP over SSL). Unset => `imap-poll` reads lead_desk/data/sample_inbox/*.eml
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Idealista Search API (requires Idealista partner approval). Unset => mock inventory.
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
IDEALISTA_COUNTRY=pt
IDEALISTA_MAX_ITEMS=50
IDEALISTA_DEFAULT_RADIUS_KM=10

# Scraping stays disabled until a ToS / legal review.
FEATURE_SCRAPE_LISTINGS=false
