# Copy to .env and fill in values. Never commit real secrets.

# OpenAI (Round 1 n8n HTTP + Round 2 MVP)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: LangSmith (Round 2 only — do not submit a LangSmith project in Round 1)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=capstone-lead-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional n8n / webhook demo
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/lead-score

# ---------------------------------------------------------------------------
# Lead Desk (lead_desk/) — see lead_desk/README.md for what each variable does.
# Every channel is optional. Missing values => that notifier runs in dry-run.
# Notifiers message the AGENT only. Nothing is ever sent to the customer.
# ---------------------------------------------------------------------------
LEAD_DESK_DB_PATH=lead_desk.sqlite3
LEAD_DESK_TENANT_ID=tenant_demo
LEAD_DESK_SALES_LED=true
LEAD_DESK_MAX_MATCHES=3
# Master switch for real agent notifications. Keep false for demos.
LEAD_DESK_NOTIFY_LIVE=false

# Agent notifier: email (SMTP, STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AGENT_EMAIL_TO=

# Agent notifier: WhatsApp Business Cloud API (to the agent's own number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
AGENT_WHATSAPP_TO=
# Inbound WhatsApp webhook stub
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Agent notifier: Telegram bot (to the agent's own chat)
TELEGRAM_BOT_TOKEN=
AGENT_TELEGRAM_CHAT_ID=
# Inbound Telegram webhook stub (setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=

# Email intake (IMAP over SSL). Unset => `imap-poll` reads lead_desk/data/sample_inbox/*.eml
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Listing providers. v1 uses the mock inventory; both flags stay false.
FEATURE_PARTNER_LISTINGS_API=false
FEATURE_SCRAPE_LISTINGS=false
