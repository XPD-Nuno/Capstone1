        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst prompt = $env.LEAD_SCORING_PROMPT || 'See repo n8n/prompts/lead_scoring_v1.md';\nreturn [{\n  json: {\n    model: 'gpt-4o-mini',\n    temperature: 0,\n    response_format: { type: 'json_object' },\n    messages: [\n      { role: 'system', content: prompt },\n      { role: 'user', content: JSON.stringify(b) }\n    ],\n    lead_id: b.lead_id || 'unknown'\n  }\n}];"
      },
      "id": "code-build",
      "name": "Build OpenAI Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
