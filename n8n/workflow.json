      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.model, temperature: $json.temperature, response_format: $json.response_format, messages: $json.messages }) }}",
        "options": {}
      },
      "id": "http-openai",
      "name": "OpenAI Chat Completions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "jsCode": "const root = $input.first().json;\nconst content = root.choices[0].message.content;\nlet parsed;\ntry { parsed = JSON.parse(content); } catch (e) {\n  parsed = { band: 'COLD', intent: 'unknown', rationale: 'Unparseable model output — fail closed', next_action: 'Human reviews raw payload', score_0_100: 0, used_banned_attribute: false };\n}\nparsed.model_version = root.model || 'gpt-4o-mini';\nparsed.usage_tokens = (root.usage || {}).total_tokens || null;\nreturn [{ json: parsed }];"
      },
      "id": "code-parse",
      "name": "Parse JSON Fail Closed",
